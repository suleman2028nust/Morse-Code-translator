				; --- Global constants (timing, colours, layout) -----------------------------
				INCLUDE morse_timing.asm
			      C ; =============================================================================
			      C ; morse_timing.asm - Constants, Timing Definitions, and Layout Parameters
			      C ; =============================================================================
			      C 
			      C ; --- Input / Timing Constants -----------------------------------------------
 = 0000003C		      C MAX_INPUT_LEN   EQU 60                  ; max characters user may type
			      C 
 = 00000320		      C DOT_FREQ        EQU 800                 ; Hz for both dot and dash beep
 = 00000096		      C DOT_DURATION    EQU 150                 ; ms – short beep  (dot)
 = 00000190		      C DASH_DURATION   EQU 400                 ; ms – long  beep  (dash)
 = 00000050		      C SYMBOL_DELAY    EQU 80                  ; ms between symbols within one letter
 = 000000FA		      C LETTER_DELAY    EQU 250                 ; ms between letters
 = 00000258		      C HIGHLIGHT_DURATION EQU 600             ; ms the colour-flash stays on
 = 00000000		      C AUDIO_PRE_DELAY EQU 00                  ; ms latency compensation
			      C 
			      C ; --- Screen Layout Parameters (BIG UI Edition) ------------------------------
			      C ; Target terminal width is 80 columns.
			      C ; BOX_WIDTH include walls. 2 walls + 74 inner = 76 total.
			      C ; BOX_LEFT=2 ... BOX_RIGHT=77
 = 00000002		      C BOX_LEFT        EQU 2
 = 0000004C		      C BOX_WIDTH       EQU 76
 = 0000004D		      C BOX_RIGHT       EQU 77
			      C 
			      C ; Row where Morse-code output is displayed
 = 00000010		      C MORSE_ROW       EQU 16
			      C 
			      C ; --- Colour Attributes ------------------------------------------------------
 = 00000009		      C COLOR_TITLE     EQU 09h                 ; bright-blue on black
 = 0000000B		      C COLOR_TITLE_ACC EQU 0Bh                 ; bright-cyan on black
 = 00000007		      C COLOR_NORMAL    EQU 07h                 ; gray on black
 = 0000000E		      C COLOR_INPUT     EQU 0Eh                 ; yellow on black
 = 0000000A		      C COLOR_MORSE     EQU 0Ah                 ; bright-green on black
 = 00000009		      C COLOR_BORDER    EQU 09h                 ; bright-blue on black
 = 0000000B		      C COLOR_PROMPT    EQU 0Bh                 ; bright-cyan on black
 = 0000000C		      C COLOR_ERROR     EQU 0Ch                 ; bright-red on black
 = 000000E0		      C COLOR_HIGHLIGHT EQU 0E0h              ; black on bright-yellow
 = 0000000F		      C COLOR_MENU_KEY  EQU 0Fh                 ; bright-white on black
 = 00000002		      C COLOR_STATUS    EQU 02h                 ; dark-green on black
 = 00000008		      C COLOR_DIM       EQU 08h                 ; dark-gray on black
			      C 
				
